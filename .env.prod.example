# Bud API — production environment.
#
# Copy to `.env` ON THE SERVER, next to compose.prod.yaml. Never commit the
# filled-in version: everything below except BUD_DOMAIN is a credential.
#
# The API validates all of this on boot and refuses to start if anything is
# missing or contradictory — a container that cannot be configured should not
# serve. Notably it will refuse to start if COOKIE_SECURE is false, or if a
# seed password is set, while NODE_ENV=production.

# --- identity ---
# The parent domain. Caddy serves api.<domain>, courses.<domain> and
# optionally app.<domain>, and all three must resolve to this machine.
BUD_DOMAIN=bud.example.com
# The shell's sign-in route; OAuth failures redirect here with ?error=<reason>.
APP_SIGN_IN_PATH=/login
CADDY_ACME_EMAIL=you@example.com

# The image to run. CI pushes sha-tagged images; pinning a sha rather than
# `latest` makes a rollback `docker compose up -d` with the old value.
BUD_API_IMAGE=ghcr.io/OWNER/bud-api:latest

# --- database ---
# Managed Postgres (Neon, Supabase) or the compose one below. If you use the
# compose one, host is `postgres` — the service name, not localhost.
POSTGRES_USER=bud
POSTGRES_PASSWORD=
POSTGRES_DB=bud
DATABASE_URL=postgresql://bud:CHANGE_ME@postgres:5432/bud?schema=public

# --- object storage ---
# Cloudflare R2, or any S3. Course packages and backups live here.
# R2 endpoint looks like https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=bud-courses
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only MinIO needs path-style addressing.
S3_FORCE_PATH_STYLE=false

# --- sessions ---
SESSION_COOKIE_NAME=bud_session
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_IDLE_TTL_HOURS=336

# --- signup ---
# invite_only keeps the front door shut. There is no invite UI by design
# (Overall Plan §8.1), so create invites with a script when you need one.
SIGNUP_MODE=invite_only

# --- GitHub OAuth (optional; set both or neither) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- mail (invites, later) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=Bud <no-reply@bud.example.com>

# --- limits ---
# Blunt per-IP ceiling. The bridge's state endpoints carry their own per-user
# allowance, which is the one that actually matters.
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=60000

# --- errors ---
SENTRY_DSN=

# --- backups (infra/backup.sh) ---
BACKUP_PREFIX=backups/postgres
BACKUP_KEEP_DAYS=30
# Defaults to S3_BUCKET. A separate bucket is better: a credential leak that
# lets someone delete course files should not also delete the backups.
BACKUP_BUCKET=

# --- the shell ---
# Only when running the Next.js app on this box rather than Vercel.
BUD_WEB_UPSTREAM=web:3000
