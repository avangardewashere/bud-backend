# ─────────────────────────────────────────────────────────────
# Bud API — environment
# Copy to .env and fill in. Validated on boot (src/config/env.schema.ts);
# the process exits if anything here is missing or malformed.
# ─────────────────────────────────────────────────────────────

# --- runtime ---
NODE_ENV=development
PORT=3102
HOST=0.0.0.0
LOG_LEVEL=debug

# --- origins ---
# The Next.js shell. Used for CORS and as the bridge postMessage target.
APP_ORIGIN=http://localhost:3100
# The shell's sign-in route. OAuth failures redirect here with ?error=<reason>.
APP_SIGN_IN_PATH=/login
# Where course HTML is served from. MUST differ from APP_ORIGIN (see Tech-Information.md 11).
COURSES_ORIGIN=http://127.0.0.1:3101
# Serve course content from this process on this port. Leave unset in local
# development: the shell runs its own courses server on 3101 and the two would
# clash. Set it to point COURSES_ORIGIN at the real, object-storage-backed path.
COURSES_PORT=
# Public URL of this API, used in OAuth callbacks and Swagger.
API_ORIGIN=http://localhost:3102

# --- database ---
# Host port 5434 — see the note on the postgres service in compose.yaml.
DATABASE_URL=postgresql://bud:bud@localhost:5434/bud?schema=public

# --- sessions ---
SESSION_COOKIE_NAME=bud_session
# Absolute lifetime of a session, in days.
SESSION_ABSOLUTE_TTL_DAYS=30
# Idle timeout, in hours. A session unused for this long is dead.
SESSION_IDLE_TTL_HOURS=336
# Leave blank for host-only cookies in dev. In prod: .yourdomain.com
COOKIE_DOMAIN=
# Must be true in production (HTTPS only).
COOKIE_SECURE=false

# --- signup ---
# invite_only | open | closed
SIGNUP_MODE=invite_only

# --- GitHub OAuth (optional in Phase 0; leave blank to disable the route) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- object storage (S3-compatible: MinIO locally, R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bud-courses
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style addressing; R2/S3 do not.
S3_FORCE_PATH_STYLE=true

# --- mail (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Bud <no-reply@bud.local>"

# --- rate limiting ---
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=60000

# --- errors (optional) ---
SENTRY_DSN=

# --- seed (development only) ---
SEED_ADMIN_EMAIL=admin@bud.local
SEED_ADMIN_PASSWORD=changeme-in-your-own-env
SEED_ADMIN_NAME=Bud Admin
